# Database
DATABASE_URL="postgresql://karimmohamed@localhost:5432/lensflow_dev"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# AI (optional — falls back to a deterministic rule-based engine when unset)
OPENAI_API_KEY=""

# Payments (optional — falls back to demo/simulated checkout when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (optional — falls back to console logging when unset)
RESEND_API_KEY=""

# SMS (optional — falls back to console logging when unset)

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Daily automation sweep (Vercel Cron sends it as a bearer token)
CRON_SECRET=""

# ── Integrations (Daythread-owned developer apps; customers authorize through the provider) ──
# Google (Gmail + Google Calendar): OAuth client from Google Cloud Console.
#   Authorized redirect URI: https://daythread.org/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Instagram (Instagram API with Instagram Login): the Instagram app id/secret from the Meta app.
#   Redirect URI: https://daythread.org/api/auth/instagram/callback
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# WhatsApp Cloud API via Embedded Signup: the Meta app id/secret and the Embedded Signup configuration id.
#   Redirect URI: https://daythread.org/api/auth/whatsapp/callback
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_CONFIG_ID=""
# Meta webhook (Instagram + WhatsApp): https://daythread.org/api/webhooks/meta — any random string, matched on the handshake.
META_WEBHOOK_VERIFY_TOKEN=""
# Twilio (platform account; businesses get their own number from Settings → Integrations).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Optional platform fallback sender when a business has no number yet.
TWILIO_FROM_NUMBER=""
# Credential encryption at rest (required in production; rotate with _PREVIOUS then POST /api/admin/reencrypt-tokens).
INTEGRATION_TOKEN_ENCRYPTION_KEY=""
INTEGRATION_TOKEN_ENCRYPTION_KEY_PREVIOUS=""
