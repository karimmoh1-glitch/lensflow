# Database
DATABASE_URL="postgresql://karimmohamed@localhost:5432/lensflow_dev"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# AI (optional — falls back to a deterministic rule-based engine when unset)
OPENAI_API_KEY=""

# Payments (optional — falls back to demo/simulated checkout when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (optional — falls back to console logging when unset)
RESEND_API_KEY=""

# SMS (optional — falls back to console logging when unset)

# App — every OAuth redirect and the Meta webhook URL are built from this, never from the
# incoming request's host. In production it must be the real https domain: a localhost or a
# *.vercel.app preview URL is reported as invalid because Meta could never call it back.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Daily automation sweep (Vercel Cron sends it as a bearer token)
CRON_SECRET=""

# ── Integrations (Daythread-owned developer apps; customers authorize through the provider) ──
# Google (Gmail + Google Calendar): OAuth client from Google Cloud Console.
#   Authorized redirect URI: https://daythread.org/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# ── Meta: Instagram + WhatsApp ──────────────────────────────────────────────
# All six are server-only. None is ever sent to a browser; Settings → Integrations shows
# whether each is Configured / Missing / Invalid, never its value. See docs/integrations/meta.md.
#
# Instagram API with Instagram Login — the *Instagram* app id/secret (Meta app →
# Instagram → API setup with Instagram login), not the Facebook app id/secret.
#   OAuth redirect URI to register: https://daythread.org/api/auth/instagram/callback
#   Scopes: instagram_business_basic, instagram_business_manage_messages
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# WhatsApp Cloud API via Embedded Signup — the Meta *app* id/secret plus the Embedded
# Signup configuration id (Meta app → WhatsApp → Embedded Signup → configuration).
#   Facebook Login for Business redirect URI: https://daythread.org/api/auth/whatsapp/callback
#   Scopes: whatsapp_business_management, whatsapp_business_messaging, business_management
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_CONFIG_ID=""
# One webhook for both products: https://daythread.org/api/webhooks/meta
# The verify token is any long random string; Meta echoes it on the handshake and Daythread
# compares it in constant time. Event signatures are verified against the app secrets above.
META_WEBHOOK_VERIFY_TOKEN=""
# Twilio (platform account; businesses get their own number from Settings → Integrations).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Optional platform fallback sender when a business has no number yet.
TWILIO_FROM_NUMBER=""
# Credential encryption at rest (required in production; rotate with _PREVIOUS then POST /api/admin/reencrypt-tokens).
INTEGRATION_TOKEN_ENCRYPTION_KEY=""
INTEGRATION_TOKEN_ENCRYPTION_KEY_PREVIOUS=""
