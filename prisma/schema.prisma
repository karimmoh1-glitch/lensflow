generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy & identity
// ─────────────────────────────────────────────────────────────────────────

model Business {
  id         String   @id @default(cuid())
  name       String
  handle     String   @unique // used in public booking URL: /book/[handle]
  specialties String[] @default([])
  businessType String? // free-text category captured at signup, e.g. "Wedding photography"
  phone      String?
  bio        String?
  logoUrl    String?
  timezone   String   @default("America/New_York")
  currency   String   @default("usd")

  // Booking policy
  depositPercent   Int   @default(30) // % of service price required to confirm a booking
  bufferMinutes    Int   @default(30) // gap enforced between bookings
  bookingLeadHours Int   @default(24) // minimum notice required to book
  paymentMethods   String[] @default([]) // "card" | "zelle" | "bank_transfer"
  zelleHandle      String?
  bankInstructions String?

  // Inbound routing for real channel webhooks — set once a business connects a real
  // SMS number; email inbound routes by handle@inbound domain instead, no field needed.
  twilioPhoneNumber String? @unique

  onboardingStep     Int     @default(0)
  // What the owner said matters most during onboarding ("messages", "clients", "bookings",
  // "payments", "follow-ups") — shapes the first-run experience and the dashboard order.
  priorities         String[] @default([])
  onboardingComplete Boolean @default(false)

  // Daythread's own subscription — this business paying US for the platform. Distinct
  // from MembershipPlan/Subscription below, which is a photographer's own client paying
  // THEM for a recurring package. Source of truth is always Stripe via the webhook
  // handler (see src/app/api/webhooks/stripe) — never set these from a client request.
  planTier             PlanTier      @default(FREE)
  billingStatus        BillingStatus?
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgMemberships OrgMembership[]
  invitations    Invitation[]
  services       Service[]
  availabilities Availability[]
  blockedDates   BlockedDate[]
  clients        Client[]
  leads          Lead[]
  conversations  Conversation[]
  bookings       Booking[]
  payments       Payment[]
  invoices       Invoice[]
  automations    Automation[]
  automationRuns AutomationExecution[]
  integrations   Integration[]
  membershipPlans MembershipPlan[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  joinRequests   JoinRequest[]
  analyticsEvents AnalyticsEvent[]
  senderRules     SenderRule[]
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

// Mirrors Stripe subscription statuses we actually branch on. Distinct from
// SubscriptionStatus below (that one is for a photographer's own client memberships).
enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

// A user's role within a specific organization — see OrgMembership. Never trust a role
// passed from the client; every access check re-derives it from the database.
enum Role {
  OWNER        // created the organization; full access, cannot be removed by others
  ADMIN        // full operational access, can manage team/settings/invitations
  PHOTOGRAPHER // manages bookings, clients, payments within the org
  PARTNER      // limited access to explicitly assigned bookings only
  CLIENT       // access to only their own bookings/payments/files within this org
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgMemberships     OrgMembership[]
  invitationsSent    Invitation[]         @relation("InvitedBy")
  clientProfile      Client?
  sentMessages       Message[]            @relation("SentByUser")
  notes              ClientNote[]
  passwordResetTokens PasswordResetToken[]
  joinRequests       JoinRequest[]
}

// The tenancy join table: one row per (user, organization) pair. A user may belong to
// multiple organizations (e.g. a partner working with several studios); every backend
// query is scoped through the active membership resolved in lib/auth.ts, never a raw id
// from the client.
model OrgMembership {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role
  status     MembershipStatus  @default(ACTIVE)
  createdAt  DateTime          @default(now())

  // Owner-controlled partner permission: by default a partner only sees conversations
  // tied to clients from bookings assigned to them. When true, they see every business
  // conversation. Irrelevant for non-PARTNER roles, which already see everything.
  canViewAllConversations Boolean @default(false)

  assignedBookings Booking[] @relation("AssignedPartner")

  @@unique([userId, businessId])
  @@index([businessId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// A secure, single-use invitation to join an organization with a specific role.
// The token is a random opaque string (never a database id) so it can't be guessed.
model Invitation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  role       Role
  token      String   @unique

  // For CLIENT invitations, pre-links to the CRM record so accepting the invite attaches
  // the new account to the right client — never left for the client to figure out.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  invitedByUserId String?
  invitedBy       User?   @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([businessId, status])
  @@index([email])
}

// A single-use, short-lived token for the "forgot password" flow. Same shape/rationale
// as Invitation.token — a random opaque string, never a database id.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A request from a user to join an existing business, made from the public "Join a
// business" signup path. Never grants membership on its own — an owner/admin must
// accept it, and accepting always lands the requester as a CLIENT (never a partner or
// staff role). See promoteToPartner for the only path from there to elevated access.
model JoinRequest {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     JoinRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  decidedAt  DateTime?

  @@unique([userId, businessId])
  @@index([businessId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Services & availability
// ─────────────────────────────────────────────────────────────────────────

model Service {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  priceCents    Int
  durationMins  Int      @default(60)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]
  leads    Lead[]

  @@index([businessId])
}

model Availability {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday    Int // 0=Sunday .. 6=Saturday
  startMin   Int // minutes from midnight, local business timezone
  endMin     Int

  @@index([businessId])
}

model BlockedDate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime // whole day blocked
  reason     String?

  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────────────────
// Clients & leads
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  instagram  String?
  notesText  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Receiving a message from someone doesn't make them a customer. A record starts as a
  // LEAD (potential client) and becomes a CUSTOMER when a real relationship exists — a
  // booking or a payment. CONTACT is for people the business talks to who aren't buying.
  relationship ClientRelationship @default(LEAD)

  // Set once the client accepts an invitation and creates a login — before that, this is
  // just a CRM record with no portal access.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  leads         Lead[]
  conversations Conversation[]
  bookings      Booking[]
  payments      Payment[]
  invoices      Invoice[]
  notes         ClientNote[]
  subscriptions Subscription[]
  invitations   Invitation[]
  referredById  String?
  referredBy    Client?  @relation("Referrals", fields: [referredById], references: [id])
  referrals     Client[] @relation("Referrals")

  @@index([businessId])
  @@index([businessId, email])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([clientId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  BOOKED
  COLD
  LOST
}

enum LeadIntent {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
}

model Lead {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  conversationId String? @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  // AI-extracted structured fields — null means "unknown", never invented
  extractedName     String?
  serviceId         String?
  service           Service? @relation(fields: [serviceId], references: [id])
  requestedDateText String? // raw text like "June 14" before resolution
  requestedDate     DateTime?
  requestedLocation String?
  budgetCents       Int?
  intent            LeadIntent @default(UNKNOWN)

  score       Int        @default(0) // 0-100, explainable — see lib/leadScoring.ts
  scoreReasons String[]  @default([])
  estimatedValueCents Int @default(0)
  status      LeadStatus @default(NEW)

  lastInboundAt DateTime?
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Omnichannel inbox
// ─────────────────────────────────────────────────────────────────────────

enum ChannelType {
  INSTAGRAM
  EMAIL
  SMS
  WHATSAPP
  WEBSITE
  PHONE
}

model Conversation {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?     @relation(fields: [clientId], references: [id])
  channel    ChannelType
  externalHandle String? // e.g. @sarah.jpg on Instagram, phone number, email address
  subject    String?
  lastMessageAt DateTime @default(now())
  archived   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  // What this conversation is, decided at ingestion (see lib/classifyMessage.ts) and
  // adjustable by the user. Priority is a view over this; nothing is ever deleted to
  // keep it clean. Legacy rows default to PRIORITY — they were all real people.
  category       ConversationCategory @default(PRIORITY)
  categoryReason String?
  categorySource String? // "rules" | "user"

  // Read state for the business (one shared inbox): unread when the last inbound message
  // is newer than this.
  lastReadAt DateTime?
  // The latest summary (AI when configured, deterministic extraction otherwise), kept so it
  // doesn't have to be regenerated every open. Never a substitute for the messages.
  summary       Json?
  summaryAt     DateTime?
  summarySource String? // "ai" | "rules"

  messages Message[]
  lead     Lead?
  bookings Booking[]

  @@index([businessId, lastMessageAt])
  @@index([businessId, clientId])
  @@index([businessId, category, lastMessageAt])
}

enum ClientRelationship {
  LEAD
  CUSTOMER
  CONTACT
}

enum ConversationCategory {
  PRIORITY
  AUTOMATED
  PROMOTIONAL
  VENDOR // a platform or supplier the business uses
  INTERNAL // the business's own team
  SPAM
}

/// A correction the business made ("not priority", "this sender is a customer"), kept per
/// tenant and consulted first on every future message from that sender or domain. Never
/// shared across businesses.
model SenderRule {
  id         String               @id @default(cuid())
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String // "email" | "domain"
  value      String // lower-cased address or domain
  category   ConversationCategory
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([businessId, kind, value])
  @@index([businessId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  DRAFT
  SENT
  DELIVERED
  FAILED
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  aiDrafted      Boolean          @default(false)
  status         MessageStatus    @default(SENT)
  sentByUserId   String?
  sentByUser     User?            @relation("SentByUser", fields: [sentByUserId], references: [id])
  createdAt      DateTime         @default(now())

  // The email provider's own message id (Resend's `id` on send, `message_id` on
  // receive) — used for two real things, not decoration: (1) deduping a webhook Resend
  // retries after a timeout, so the same inbound email never gets ingested twice, and
  // (2) setting In-Reply-To/References on our outbound sends so the customer's mail
  // client threads the conversation correctly on their end too.
  providerMessageId String?

  // Original pre-normalization content (whichever of text/html the provider handed
  // over), kept only so a real parsing problem can be diagnosed after the fact —
  // never rendered anywhere in the conversation UI, only `body` is.
  rawBody String?

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
}

// ─────────────────────────────────────────────────────────────────────────
// Bookings
// ─────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  INQUIRY
  BOOKED
  DEPOSIT_PAID
  CONFIRMED
  QUESTIONNAIRE_COMPLETE
  UPCOMING
  COMPLETED
  BALANCE_PAID
  FOLLOWED_UP
  CANCELED
}

model Booking {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])

  // Least-privilege partner access: a partner only sees bookings explicitly assigned to them.
  assignedMembershipId String?
  assignedMembership    OrgMembership? @relation("AssignedPartner", fields: [assignedMembershipId], references: [id])

  startAt  DateTime
  endAt    DateTime
  location String?

  status        BookingStatus @default(INQUIRY)
  totalCents    Int
  depositCents  Int
  confirmedAt   DateTime?
  completedAt   DateTime?

  // Delivery — a real link (Pixieset/Drive/Dropbox gallery) + note the photographer sets
  // once the shoot is edited. No file storage of our own; this is how most working
  // photographers actually deliver galleries, so it's a real field, not a placeholder.
  deliveryUrl  String?
  deliveryNote String?
  deliveredAt  DateTime?

  questionnaire         Questionnaire?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  invoice  Invoice?
  reminders Reminder[]

  @@index([businessId, startAt])
  @@index([businessId, status])
  @@index([businessId, clientId])
}

model Questionnaire {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  answers   Json     @default("{}")
  completedAt DateTime?
  sentAt    DateTime?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Payments & invoicing
// ─────────────────────────────────────────────────────────────────────────

enum PaymentMethodType {
  CARD
  APPLE_PAY
  ZELLE
  BANK_TRANSFER
}

enum PaymentPurpose {
  DEPOSIT
  BALANCE
  FULL
  SUBSCRIPTION
}

enum PaymentStatus {
  AWAITING_CONFIRMATION
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking?          @relation(fields: [bookingId], references: [id])
  clientId   String
  client     Client            @relation(fields: [clientId], references: [id])
  method     PaymentMethodType
  purpose    PaymentPurpose
  amountCents Int
  status     PaymentStatus     @default(AWAITING_CONFIRMATION)
  reference  String? // Zelle/bank memo reference shown to customer
  stripePaymentIntentId String?
  confirmedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([businessId, status])
  @@index([businessId, clientId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId     String?       @unique
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  number        String        @unique
  subtotalCents Int
  discountCents Int           @default(0)
  totalCents    Int
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([businessId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Subscriptions / memberships
// ─────────────────────────────────────────────────────────────────────────

model MembershipPlan {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  priceCents    Int
  intervalMonths Int     @default(1)
  sessionsPerInterval Int @default(1)
  perks         String[] @default([])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]

  @@index([businessId])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id              String             @id @default(cuid())
  clientId        String
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId          String
  plan            MembershipPlan     @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(ACTIVE)
  sessionsRemaining Int              @default(0)
  currentPeriodEnd DateTime
  createdAt       DateTime           @default(now())

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Automations
// ─────────────────────────────────────────────────────────────────────────

enum AutomationTrigger {
  BOOKING_CREATED
  DEPOSIT_PAID
  DAYS_BEFORE_SHOOT
  SHOOT_COMPLETED
  PAYMENT_DUE_SOON
  PAYMENT_OVERDUE
  LEAD_INACTIVE
}

enum AutomationAction {
  SEND_CONFIRMATION
  SEND_QUESTIONNAIRE
  SEND_REMINDER
  SEND_THANK_YOU
  SEND_PAYMENT_REMINDER
  SEND_FOLLOW_UP
}

model Automation {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  trigger     AutomationTrigger
  offsetHours Int               @default(0) // e.g. 24 for "24 hours before/after"
  action      AutomationAction
  messageTemplate String
  enabled     Boolean           @default(true)
  createdAt   DateTime          @default(now())

  runs AutomationExecution[]

  @@index([businessId])
}

model AutomationExecution {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  targetType   String // "booking" | "lead" | "payment"
  targetId     String
  ranAt        DateTime   @default(now())
  result       String // "sent" | "skipped" | "failed"

  @@index([businessId, automationId])
}

model Reminder {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind      String // "shoot" | "payment" | "questionnaire"
  dueAt     DateTime
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// ─────────────────────────────────────────────────────────────────────────
// Integrations
// ─────────────────────────────────────────────────────────────────────────

enum IntegrationProvider {
  INSTAGRAM
  EMAIL
  SMS
  WHATSAPP
  PHONE
  WEBSITE
  CALENDAR
  STRIPE
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
  DEMO
}

model Integration {
  id           String              @id @default(cuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider     IntegrationProvider
  status       IntegrationStatus   @default(NOT_CONNECTED)
  externalAccount String?
  lastSyncedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Real OAuth tokens for a per-business connection (currently Gmail) — set only after
  // the owner completes Google's actual consent screen, never fabricated. accessToken
  // is short-lived and refreshed on demand via refreshToken; tokenExpiresAt tracks when
  // that refresh is due.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  @@unique([businessId, provider])
}

// ─────────────────────────────────────────────────────────────────────────
// System
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([businessId, read])
}

/// Guards every webhook handler (Stripe today, others later) against double-processing —
/// a provider can and will redeliver the same event after a timeout or on retry. Insert
/// happens first, inside the same transaction as the state change it guards: if the event
/// id is already present, the unique constraint fails and the handler no-ops.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String // "stripe", etc.
  eventId    String
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// Own-database funnel analytics — no third-party analytics provider is configured in this
/// deployment, and one isn't fabricated here. businessId is nullable because the funnel
/// starts before a business exists (landing CTA click, signup started) — anonymousId
/// (a client-set cookie/localStorage value, never anything identifying) is what threads
/// pre-signup events to the same visitor. No email/name/IP is ever stored here.
model AnalyticsEvent {
  id           String   @id @default(cuid())
  name         String // e.g. "signup_completed", "checkout_started" — see lib/analytics.ts for the canonical list
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  anonymousId  String?
  properties   Json?
  createdAt    DateTime @default(now())

  @@index([name, createdAt])
  @@index([businessId, name])
}
